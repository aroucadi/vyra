rules_version = '2';

// VYRA Cloud Firestore Security Rules
// All client persistence and multi-tenant data reads/writes go exclusively through
// verified Next.js / Cloud Run server routes using Firebase Admin SDK (ADC),
// ensuring zero direct client-side cross-tenant reads or writes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
